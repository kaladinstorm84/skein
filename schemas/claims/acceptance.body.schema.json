{
  "$id": "https://skein.dev/schema/v1/claims/acceptance.body.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["condition", "judgment_method"],
  "properties": {
    "condition": { "type": "string", "minLength": 1 },
    "judgment_method": {
      "type": "string",
      "enum": ["test", "review", "inspection", "invariant"]
    }
  }
}
