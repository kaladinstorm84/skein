{
  "$id": "https://skein.dev/schema/v1/claims/policy_update.body.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["resulting_policy_hash", "reason"],
  "properties": {
    "resulting_policy_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reason": { "type": "string", "minLength": 1 }
  }
}
