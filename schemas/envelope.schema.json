{
  "$id": "https://skein.dev/schema/v1/envelope.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skein issuance envelope (kind envelope)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_kind",
    "object_id",
    "issuer_id",
    "issuer_class",
    "auth_method",
    "signature",
    "issued_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "object_kind": {
      "type": "string",
      "enum": [
        "claim",
        "witness",
        "proposal",
        "weave-proposal",
        "weave",
        "policy"
      ]
    },
    "object_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "issuer_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "issuer_class": { "type": "string", "enum": ["human", "agent", "runner"] },
    "auth_method": {
      "type": "string",
      "enum": ["development-key", "webauthn", "runner-mac"]
    },
    "signature": { "type": "string", "minLength": 1 },
    "issued_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
